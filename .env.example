# Server-only secret. Never rename this to NEXT_PUBLIC_HF_TOKEN.
HF_TOKEN=

# Optional model overrides. The app has defaults, so these may stay empty.
HF_CHAT_MODEL=
HF_VISION_MODEL=
HF_IMAGE_MODEL=

# Server-only Gemini key used by Chat Assistant.
GEMINI_API_KEY=

# Optional Gemini chat model override.
GEMINI_CHAT_MODEL=
